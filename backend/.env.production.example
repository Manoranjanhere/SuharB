# Copy to .env on the server.

NODE_ENV=production
PORT=3000
DISABLE_PAID_FEATURES=false

# Postgres runs in Docker on the same EC2 host (service "postgres" in docker-compose.yml)
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=change_me_to_a_long_random_password
DB_NAME=sugarbf
DB_SSL=false
DB_SYNCHRONIZE=false
DB_MIGRATIONS_RUN=true

# Copy remaining vars from your local .env (JWT, Firebase, AWS, etc.)
